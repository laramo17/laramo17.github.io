---
import ProjectCard from "./ProjectCard.astro";
import SectionTitle from "./SectionTitle.astro";
import { projects } from "../data/projects";
import type { ProjectCategory } from "../data/types";

const sorted = [...projects].sort((a, b) => Number(b.featured) - Number(a.featured));

const filters: { key: ProjectCategory | "all"; label: string }[] = [
  { key: "all", label: "Tous" },
  { key: "dev", label: "Dev" },
  { key: "data", label: "Data" },
  { key: "ai-ml", label: "AI & ML" },
];

const counts: Record<string, number> = {
  all: projects.length,
  dev: projects.filter((p) => p.category === "dev").length,
  data: projects.filter((p) => p.category === "data").length,
  "ai-ml": projects.filter((p) => p.category === "ai-ml").length,
};
---

<section id="projets" class="py-20 sm:py-28 bg-[var(--color-bg-alt)]">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionTitle
      eyebrow="Projets"
      title="Ce que j'ai construit"
      subtitle="Chaque carte ouvre le dépôt GitHub correspondant."
    />

    <div
      id="project-filters"
      class="reveal mt-10 inline-flex max-w-full flex-wrap gap-1 rounded-2xl border border-[var(--color-border)] bg-white p-1.5 shadow-sm"
      role="tablist"
      aria-label="Filtrer les projets par catégorie"
    >
      {filters.map((f, i) => (
        <button
          type="button"
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          data-filter={f.key}
          class="filter-btn rounded-xl px-4 py-2 text-sm font-semibold text-[var(--color-text-muted)] transition hover:text-[var(--color-text)] aria-selected:bg-[var(--color-ink)] aria-selected:text-white aria-selected:shadow"
        >
          {f.label} <span class="ml-1 font-mono text-xs opacity-60">{counts[f.key]}</span>
        </button>
      ))}
    </div>

    <div id="project-grid" class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sorted.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const buttons = document.querySelectorAll("#project-filters .filter-btn");
    const cards = document.querySelectorAll("#project-grid .project-card");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        buttons.forEach((b) => b.setAttribute("aria-selected", "false"));
        btn.setAttribute("aria-selected", "true");

        const filter = btn.getAttribute("data-filter");
        cards.forEach((card) => {
          const match = filter === "all" || card.getAttribute("data-category") === filter;
          card.hidden = !match;
          if (match) {
            card.classList.add("is-visible");
            if (reduceMotion) return;
            card.animate(
              [
                { opacity: 0, transform: "translateY(8px)" },
                { opacity: 1, transform: "translateY(0)" },
              ],
              { duration: 280, easing: "ease-out" },
            );
          }
        });
      });
    });
  })();
</script>
