---
import Icon from "./Icon.astro";
import type { Project } from "../data/types";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const categoryMeta = {
  dev: {
    label: "Dev",
    icon: "code" as const,
    text: "text-[var(--color-cat-dev)]",
    bg: "bg-[var(--color-cat-dev-soft)]",
  },
  data: {
    label: "Data",
    icon: "database" as const,
    text: "text-[var(--color-cat-data)]",
    bg: "bg-[var(--color-cat-data-soft)]",
  },
  "ai-ml": {
    label: "AI & ML",
    icon: "brain" as const,
    text: "text-[var(--color-cat-ai)]",
    bg: "bg-[var(--color-cat-ai-soft)]",
  },
};

const meta = categoryMeta[project.category];
---

<article
  class="project-card reveal group relative flex flex-col rounded-2xl border border-[var(--color-border)] bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg"
  data-category={project.category}
>
  <a
    href={project.githubUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="absolute inset-0 z-0"
    aria-label={`Voir le dépôt GitHub de ${project.title}`}
  ></a>

  <div class="relative z-10 flex items-center justify-between pointer-events-none">
    <span
      class={`inline-flex items-center gap-1.5 rounded-full ${meta.bg} ${meta.text} px-3 py-1 text-xs font-semibold`}
    >
      <Icon name={meta.icon} class="w-3.5 h-3.5" />
      {meta.label}
    </span>
    {project.featured && <span class="text-xs font-semibold text-amber-600">★ Featured</span>}
  </div>

  <h3 class="relative z-10 pointer-events-none mt-4 text-lg font-bold text-[var(--color-text)]">
    {project.title}
  </h3>
  <p class="relative z-10 pointer-events-none mt-2 text-sm text-[var(--color-text-muted)] flex-1">
    {project.description}
  </p>

  <div class="relative z-10 pointer-events-none mt-4 flex flex-wrap gap-2">
    {project.technologies.map((tech) => (
      <span class="rounded-full border border-[var(--color-border)] px-2.5 py-1 text-xs font-medium text-[var(--color-text-muted)]">
        {tech}
      </span>
    ))}
  </div>

  <div class="relative z-10 mt-5 flex items-center gap-4 pointer-events-none">
    <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-primary)] group-hover:text-[var(--color-primary-hover)]">
      <Icon name="github" class="w-4 h-4" />
      Voir sur GitHub
    </span>
    {project.demoUrl && (
      <a
        href={project.demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="pointer-events-auto relative z-20 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-primary)]"
      >
        <Icon name="external-link" class="w-4 h-4" />
        Démo
      </a>
    )}
  </div>
</article>
