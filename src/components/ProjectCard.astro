---
import Icon from "./Icon.astro";
import type { Project } from "../data/types";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const categoryMeta = {
  dev: {
    label: "Dev",
    icon: "code" as const,
    text: "text-[var(--color-cat-dev)]",
    bg: "bg-[var(--color-cat-dev-soft)]",
    from: "#2563eb",
    to: "#3b82f6",
  },
  data: {
    label: "Data",
    icon: "database" as const,
    text: "text-[var(--color-cat-data)]",
    bg: "bg-[var(--color-cat-data-soft)]",
    from: "#0d9488",
    to: "#06b6d4",
  },
  "ai-ml": {
    label: "AI & ML",
    icon: "brain" as const,
    text: "text-[var(--color-cat-ai)]",
    bg: "bg-[var(--color-cat-ai-soft)]",
    from: "#6366f1",
    to: "#a855f7",
  },
};

const meta = categoryMeta[project.category];
---

<article
  class="project-card card-glow reveal group relative flex flex-col rounded-2xl border border-[var(--color-border)] bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl"
  style={`--glow-from: ${meta.from}; --glow-to: ${meta.to};`}
  data-category={project.category}
>
  <span
    class="absolute inset-x-6 top-0 h-0.5 rounded-b-full"
    style={`background: linear-gradient(90deg, ${meta.from}, ${meta.to});`}
    aria-hidden="true"
  ></span>

  <a
    href={project.githubUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="absolute inset-0 z-0 rounded-2xl"
    aria-label={`Voir le dépôt GitHub de ${project.title}`}
  ></a>

  <div class="pointer-events-none relative z-10 flex items-center justify-between">
    <span class={`grid h-10 w-10 place-items-center rounded-xl ${meta.bg} ${meta.text}`}>
      <Icon name={meta.icon} class="h-5 w-5" />
    </span>
    <div class="flex items-center gap-2">
      {project.featured && (
        <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 ring-1 ring-amber-200">
          ★ À la une
        </span>
      )}
      <span class={`rounded-full ${meta.bg} ${meta.text} px-2.5 py-1 text-xs font-semibold`}>
        {meta.label}
      </span>
    </div>
  </div>

  <h3 class="pointer-events-none relative z-10 mt-5 text-lg font-bold text-[var(--color-text)]">
    {project.title}
  </h3>
  <p class="pointer-events-none relative z-10 mt-2 flex-1 text-sm leading-relaxed text-[var(--color-text-muted)]">
    {project.description}
  </p>

  <div class="pointer-events-none relative z-10 mt-5 flex flex-wrap gap-1.5">
    {project.technologies.map((tech) => (
      <span class="rounded-md bg-[var(--color-bg-alt)] px-2 py-1 font-mono text-[11px] font-medium text-[var(--color-text-muted)] ring-1 ring-[var(--color-border)]">
        {tech}
      </span>
    ))}
  </div>

  <div class="pointer-events-none relative z-10 mt-6 flex items-center gap-4 border-t border-[var(--color-border)] pt-4">
    <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-text)] transition group-hover:text-[var(--color-primary)]">
      <Icon name="github" class="h-4 w-4" />
      Voir sur GitHub
      <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">
        →
      </span>
    </span>
    {project.demoUrl && (
      <a
        href={project.demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="pointer-events-auto relative z-20 inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-primary)]"
      >
        <Icon name="external-link" class="h-4 w-4" />
        Démo
      </a>
    )}
  </div>
</article>
