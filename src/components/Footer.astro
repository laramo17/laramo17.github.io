---
import { profile } from "../data/profile";

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-[var(--color-ink)] py-8">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 text-sm text-slate-400 sm:flex-row sm:px-6">
    <p>
      &copy; {year} {profile.name}. Tous droits réservés.
    </p>
    <a
      href="https://github.com/laramo17/laramo17.github.io"
      target="_blank"
      rel="noopener noreferrer"
      class="transition-colors hover:text-white"
    >
      Code source de ce site
    </a>
  </div>
</footer>
