---
import { experiences } from "../data/experience";
import { education } from "../data/education";
---

<section id="parcours" class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="reveal text-3xl sm:text-4xl font-bold text-[var(--color-text)]">Parcours</h2>

    <ol class="mt-14 relative border-l border-[var(--color-border)] pl-8 space-y-12">
      {experiences.map((exp) => (
        <li class="reveal relative">
          <span class="absolute -left-[calc(2rem+5px)] top-1.5 w-3 h-3 rounded-full bg-[var(--color-primary)] ring-4 ring-[var(--color-primary-soft)]" />
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <h3 class="text-lg font-bold text-[var(--color-text)]">{exp.role}</h3>
            <span class="text-sm font-medium text-[var(--color-text-muted)] whitespace-nowrap">
              {exp.startDate} — {exp.endDate}
            </span>
          </div>
          <p class="mt-1 font-semibold text-[var(--color-primary)]">
            {exp.company}
            {exp.location ? ` · ${exp.location}` : ""}
          </p>
          <p class="mt-3 text-[var(--color-text-muted)]">{exp.description}</p>
          <ul class="mt-3 space-y-1.5 list-disc list-inside text-sm text-[var(--color-text-muted)]">
            {exp.achievements.map((a) => (
              <li>{a}</li>
            ))}
          </ul>
          {exp.technologies.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {exp.technologies.map((tech) => (
                <span class="rounded-full bg-[var(--color-primary-soft)] px-3 py-1 text-xs font-medium text-[var(--color-primary)]">
                  {tech}
                </span>
              ))}
            </div>
          )}
        </li>
      ))}
    </ol>

    <div class="reveal mt-20">
      <h3 class="text-2xl font-bold text-[var(--color-text)]">Formation & certifications</h3>
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {education.map((edu) => (
          <div class="rounded-2xl border border-[var(--color-border)] p-6">
            <p class="font-semibold text-[var(--color-text)]">{edu.degree}</p>
            <p class="mt-1 text-sm text-[var(--color-primary)]">{edu.institution}</p>
            <p class="mt-1 text-sm text-[var(--color-text-muted)]">
              {edu.startDate} — {edu.endDate}
            </p>
            {edu.description && (
              <p class="mt-2 text-sm text-[var(--color-text-muted)]">{edu.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
