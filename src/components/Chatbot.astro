---
import Icon from "./Icon.astro";
import { chatbot } from "../data/chatbot";
import { profile } from "../data/profile";
import { experiences } from "../data/experience";
import { projects } from "../data/projects";
import { skills } from "../data/skills";
import { education } from "../data/education";
import type { ChatbotKnowledge } from "../data/types";

const knowledge: ChatbotKnowledge = {
  profile,
  experiences,
  projects: [...projects].sort((a, b) => Number(b.featured) - Number(a.featured)),
  skills,
  education,
  welcome: chatbot.welcome,
};
const knowledgeJson = JSON.stringify(knowledge).replace(/</g, "\\u003c");
---

<div id="chatbot">
  <script is:inline type="application/json" id="chatbot-data" set:html={knowledgeJson} />
  <span
    data-chatbot-teaser
    class="pointer-events-none fixed right-[5.5rem] bottom-8 z-50 hidden rounded-full bg-white px-3.5 py-2 text-xs font-semibold text-[var(--color-text)] shadow-lg ring-1 ring-[var(--color-border)] sm:block"
  >
    Une question sur {profile.name} ?
  </span>

  <button
    type="button"
    data-chatbot-toggle
    aria-label="Ouvrir l'assistant"
    aria-expanded="false"
    aria-controls="chatbot-panel"
    class="fixed right-5 bottom-5 z-50 grid h-14 w-14 place-items-center rounded-full bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-accent)] text-white shadow-lg shadow-indigo-500/30 transition hover:-translate-y-0.5 hover:shadow-xl hover:shadow-indigo-500/40"
  >
    <span data-icon-open>
      <Icon name="message" class="h-6 w-6" />
    </span>
    <span data-icon-close class="hidden">
      <Icon name="x" class="h-6 w-6" />
    </span>
  </button>

  <section
    id="chatbot-panel"
    data-chatbot-panel
    role="dialog"
    aria-label={chatbot.name}
    hidden
    class="fixed inset-x-4 bottom-24 z-[60] flex max-h-[min(36rem,calc(100dvh-8rem))] flex-col overflow-hidden rounded-2xl border border-[var(--color-border)] bg-white shadow-2xl shadow-slate-900/20 sm:inset-x-auto sm:right-5 sm:w-96"
  >
    <header class="flex items-center gap-3 bg-[var(--color-ink)] px-4 py-3 text-white">
      <span
        class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-accent)] text-sm font-bold"
        aria-hidden="true"
      >
        {profile.name.charAt(0)}
      </span>
      <div class="min-w-0">
        <p class="truncate text-sm font-semibold">{chatbot.name}</p>
        <p class="flex items-center gap-1.5 text-xs text-slate-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
          Réponses tirées de ce portfolio
        </p>
      </div>
      <button
        type="button"
        data-chatbot-close
        aria-label="Fermer l'assistant"
        class="ml-auto rounded-lg p-1.5 text-slate-400 transition hover:bg-white/10 hover:text-white"
      >
        <Icon name="x" class="h-5 w-5" />
      </button>
    </header>

    <div
      data-chatbot-messages
      role="log"
      aria-live="polite"
      class="relative min-h-40 flex-1 space-y-3 overflow-y-auto bg-[var(--color-bg-alt)] px-4 py-4"
    ></div>

    <div class="flex gap-1.5 overflow-x-auto border-t border-[var(--color-border)] px-3 py-2.5 sm:flex-wrap sm:overflow-visible">
      {chatbot.suggestions.map((s) => (
        <button
          type="button"
          data-chatbot-suggestion
          class="shrink-0 rounded-full border border-[var(--color-border)] bg-white px-2.5 py-1 text-xs font-medium text-[var(--color-text-muted)] transition hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]"
        >
          {s}
        </button>
      ))}
    </div>

    <form
      data-chatbot-form
      class="flex items-center gap-2 border-t border-[var(--color-border)] p-3"
    >
      <label for="chatbot-input" class="sr-only">
        Votre question
      </label>
      <input
        id="chatbot-input"
        data-chatbot-input
        type="text"
        autocomplete="off"
        maxlength="200"
        placeholder="Posez votre question…"
        class="min-w-0 flex-1 rounded-xl border border-[var(--color-border)] bg-white px-3 py-2 text-base text-[var(--color-text)] placeholder:text-slate-400 sm:text-sm"
      />
      <button
        type="submit"
        aria-label="Envoyer"
        class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[var(--color-ink)] text-white transition hover:bg-[var(--color-primary)]"
      >
        <Icon name="send" class="h-4 w-4" />
      </button>
    </form>
  </section>
</div>

<script>
  import { initChatbot } from "../scripts/chatbot";

  initChatbot();
</script>
