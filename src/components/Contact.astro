---
import Icon from "./Icon.astro";
import SectionTitle from "./SectionTitle.astro";
import { profile } from "../data/profile";

const links = [
  { href: `mailto:${profile.email}`, icon: "mail" as const, label: profile.email, external: false },
  { href: profile.linkedin, icon: "linkedin" as const, label: "LinkedIn", external: true },
  { href: profile.github, icon: "github" as const, label: "GitHub", external: true },
];
---

<section id="contact" class="relative overflow-hidden bg-[var(--color-ink)] py-24 sm:py-32">
  <div class="bg-grid-dark absolute inset-0" aria-hidden="true"></div>
  <div class="blob -top-20 left-1/4 h-80 w-80 bg-blue-600 opacity-30" aria-hidden="true"></div>
  <div
    class="blob right-1/4 -bottom-24 h-80 w-80 bg-indigo-600 opacity-30 [animation-delay:-6s]"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-6xl px-4 text-center sm:px-6">
    <SectionTitle
      eyebrow="Contact"
      title="Et si on construisait la suite ensemble ?"
      subtitle="Vous proposez une alternance en Dev, Data ou IA / ML pour 2026-2027, partout en France ou en Europe ? Parlons-en."
      dark
      center
    />

    <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-3">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
          class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-slate-200 backdrop-blur transition hover:-translate-y-0.5 hover:border-cyan-300/50 hover:bg-white/10 hover:text-white"
        >
          <Icon name={link.icon} class="h-4 w-4" />
          {link.label}
        </a>
      ))}
    </div>
  </div>
</section>
